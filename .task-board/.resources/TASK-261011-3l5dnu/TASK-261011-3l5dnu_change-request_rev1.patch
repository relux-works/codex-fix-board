+## Reproducible static witness
+
+This is a source-contract assertion against pinned blobs, not a substitute Rust implementation or an executed resume. Its observed output is: `legacy segment=129, path=135, new cap=128`, followed by the compatibility assertion failure; real exit 1.
+
+```python
+import re
+import subprocess
+
+base = "39c264c34e61b5171ae13b0f756746c24ea5f51a"
+candidate = "5a51cf5296c78fc1693cb6e1cfd2e7f776e2e5c8"
+def source(tree, path):
+    return subprocess.check_output(["git", "show", f"{tree}:{path}"], text=True)
+path_file = "codex-rs/protocol/src/agent_path.rs"
+old = source(base, path_file)
+new = source(candidate, path_file)
+old_name = old.split("fn validate_agent_name(", 1)[1].split("fn validate_absolute_path(", 1)[0]
+assert "MAX_SEGMENT_BYTES" not in old and "MAX_PATH_BYTES" not in old
+assert "is_ascii_lowercase()" in old_name and "agent_name.len()" not in old_name
+assert '#[serde(try_from = "String", into = "String")]' in new
+cap = int(re.search(r"MAX_SEGMENT_BYTES: usize = (\d+)", new).group(1))
+assert "name_len > AgentPath::MAX_SEGMENT_BYTES" in new
+spawn = source(base, "codex-rs/core/src/tools/handlers/multi_agents_common.rs")
+assert ".join(task_name)" in spawn
+restore = source(candidate, "codex-rs/core/src/agent/control/spawn.rs")
+resume = restore.split("async fn resume_single_agent_from_rollout(", 1)[1]
+assert ".map(AgentPath::try_from)" in resume
+assert "invalid stored agent path: {err}" in resume
+protocol = source(candidate, "codex-rs/protocol/src/protocol.rs")
+assert "agent_path: Option<AgentPath>" in protocol
+reader = source(candidate, "codex-rs/rollout/src/recorder.rs")
+assert "crate::decode_rollout_line(value)" in reader
+assert 'IoError::other("failed to parse thread ID from rollout file")' in reader
+legacy_name = "a" * 129
+legacy_path = "/root/" + legacy_name
+assert legacy_name.isascii() and legacy_name.islower() and "/" not in legacy_name
+print(f"STATIC SOURCE WITNESS: legacy segment={len(legacy_name)}, path={len(legacy_path)}, new cap={cap}", flush=True)
+print("Base grammar admits the identity; candidate stored-path parse and Serde reject it. Rust execution NOT performed.", flush=True)
+assert len(legacy_name) <= cap, "compatibility contract fails: previously admitted persisted identity rejected by shared AgentPath parser"
+```
