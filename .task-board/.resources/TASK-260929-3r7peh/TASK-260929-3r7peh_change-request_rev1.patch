+    assert!(
+        names.iter().any(|name| name == "exec_notification"),
+        "available host should list exec_notification in {names:?}"
+    );
+    assert!(
+        has_notify_on_exit,
+        "available host exec_command schema should include notify_on_exit"
+    );
+}
