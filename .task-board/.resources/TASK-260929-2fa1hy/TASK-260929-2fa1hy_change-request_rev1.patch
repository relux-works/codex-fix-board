+    );
+    test.submit_text_turn("inspect available clock tools")
+        .await?;
+
+    assert!(
+        thread_data
+            .insert(goal_activity(
+                GoalActivityState::BudgetLimited,
+                /*revision*/ 2
+            ))
+            .is_some()
+    );
+    test.submit_text_turn("inspect available clock tools")
