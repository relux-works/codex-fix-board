+#[test]
+fn revision_increases_on_queue_via_publish() {
+    let revision = Arc::new(AtomicU64::new(0));
+    let store = CompletionReceiptStore::with_revision(Arc::clone(&revision));
+    let (owner, receipt_id) = arm_receipt(&store, "queue-publish");
