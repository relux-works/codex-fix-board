+    );
+    assert_eq!(
+        test.codex.thread_extension_data().get::<GoalActivity>(),
+        None,
+        "phase C: a failed insert must revoke the marker"
+    );
+    sqlx::query("DROP TRIGGER fail_goal_insert")
