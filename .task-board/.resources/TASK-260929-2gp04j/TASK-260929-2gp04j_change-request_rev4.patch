+        .await?;
+    service
+        .set_thread_goal(
+            &db,
+            GoalSetRequest {
+                thread_id: id,
+                objective: GoalObjectiveUpdate::Set("work-4"),
+                status: None,
+                token_budget: GoalTokenBudgetUpdate::Keep,
+                max_goal_token_budget: None,
