+        store.status(receipt_id, &owner),
+        Ok(ReceiptStatus::LeasedToSampling {
+            source: SamplingSource::PushedCompletion,
+        })
+    );
+    assert_eq!(
+        store.acknowledge_sampled(&second_lease),
+        Ok(completion(Some(0)))
+    );
+}
