+    assert_eq!(
+        store.status(donor_id, &owner),
+        Ok(ReceiptStatus::LeasedToSampling {
+            source: SamplingSource::PushedCompletion
+        })
+    );
+    assert_eq!(store.acknowledge_sampled(&live), Ok(completion(Some(0))));
