+                .await
+        );
+        assert!(input_queue.has_pending_mailbox_items().await);
+        assert!(!input_queue.has_pending_input(&idle).await);
+
+        // Inter-agent mail stays in-turn follow-up work.
+        input_queue
+            .enqueue_mailbox_communication(
+                make_mail(
+                    AgentPath::root(),
+                    AgentPath::try_from("/root/worker").expect("agent path"),
+                    "follow-up",
+                    /*trigger_turn*/ false,
+                ),
+                Default::default(),
+            )
+            .await;
+        assert!(input_queue.has_pending_input(&idle).await);
+    }
+
+    #[tokio::test]
+    async fn exec_completion_input_reports_mailbox_activity() {
+        let store = crate::unified_exec::completion_receipt::CompletionReceiptStore::default();
+        let (receipt_id, owner, completion) =
