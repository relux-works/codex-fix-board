+    let harness = GoalExtensionHarness::new(runtime, thread_id).await?;
+    harness.start_turn(TURN, &TokenUsage::default()).await;
+
+    item_completed(
+        &harness,
+        TURN,
+        &file_change(Some(PatchApplyStatus::Completed)),
