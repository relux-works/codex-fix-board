+        Box::pin(async {})
+    }
+
+    fn service_tier(&self) -> Option<String> {
+        None
+    }
+
+    fn propagate_config_update(&self, _update: AgentConfigUpdate) {}
+
+    fn get_guardian_package(
+        &self,
+        _agent: ThreadId,
+    ) -> BoxFuture<'_, Option<GuardianRootSnapshot>> {
+        Box::pin(async { None })
+    }
